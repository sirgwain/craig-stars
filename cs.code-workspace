{
  "folders": [
    {
      "name": "root",
      "path": "./",
    },
    {
      "name": "frontend",
      "path": "frontend"
    },
  ],
  "settings": {
    "testing.automaticallyOpenPeekView": "never",
    "typescript.tsdk": "frontend/node_modules/typescript/lib",
    "goStructTagAutogen.generation": {      
      "template": "json:\"{{camel}},omitempty\"",
      "json": {
        "cases": ["camel"],
        "options": ["omitempty", "-"]
      }
    },
    "go.testTimeout": "90s",
    "files.associations": {
      "**/tmp/*.json": "jsonc" // enable json with comments for testing log files 
    }
  }
}