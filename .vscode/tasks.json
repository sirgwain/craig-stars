{
	"version": "2.0.0",
	"presentation": {
		"panel": "dedicated",
		"showReuseMessage": false,
		"clear": true
	},
	"type": "shell",
	"tasks": [
		{
			"label": "Run all tests",
			"command": "mage",
			"args": ["test"],
			"group": "test",
			"icon": {
				"color": "terminal.ansiGreen",
				"id": "beaker"
			},
			"detail": "Run all backend/frontend tests and linting checks."
		},
		{
			"label": "Go: run tests",
			"command": "mage",
			"args": [
				"test_golang",
				{
					"value": "${input:packages} --run=\"${input:goTestName}\"",
					"quoting": "strong"
				}
			],
			"group": "test",
			"icon": {
				"color": "terminal.ansiGreen",
				"id": "run-below"
			},
			"detail": "Run backend tests using gotestsum."
		},
		{
			"label": "Go: run benchmarks",
			"type": "go",
			"problemMatcher": "$go",
			"command": "test",
			"args": [
				"--run=$^",
				"--bench=\"${input:goTestName}\"",
				"--benchmem",
				"--benchtime=${input:benchTime}s",
				"--benchcount=5",
				"--json tmp/test-results/go-benchresults.json"
			],
			"group": "test",
			"icon": {
				"color": "terminal.ansiYellow",
				"id": "clock"
			},
			"detail": "Run Go benchmarks and save the results to JSON."
		},
		{
			"label": "Go: generate files",
			"problemMatcher": "$go",
			"group": "build",
			"icon": {
				"color": "terminal.ansiMagenta",
				"id": "table"
			},
			"command": "mage generate",
			"detail": "Generate various backend and frontend files."
		},
		{
			"label": "Build & launch server",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"dependsOn": ["Build server", "Launch server"],
			"dependsOrder": "sequence",
			"icon": {
				"color": "terminal.ansiCyan",
				"id": "browser"
			},
			"detail": "Build and start up the local server for debugging."
		},
		{
			"label": "Build server",
			"command": "mage",
			"args": ["build"],
			"group": "build",
			"icon": {
				"color": "terminal.ansiCyan",
				"id": "symbol-constructor"
			},
			"detail": "Build server without launching it."
		},
		{
			"label": "Launch server",
			"dependsOn": ["Launch backend", "Launch frontend"],
			"detail": "Launch frontend/backend servers and open localhost without building anything.",
			"group": "build",
			"icon": {
				"color": "terminal.ansiCyan",
				"id": "rocket"
			}
		},
		{
			"hide": true,
			"label": "Launch backend",
			"isBackground": true,
			"command": "mage",
			"args": ["launch_backend", "${input:testMode}"],
			"icon": {
				"color": "terminal.ansiCyan",
				"id": "radio-tower"
			},
			// problem matcher needed to signify task end so we know when to boot up the frontend
			"problemMatcher": [
				{
					"pattern": [{ "regexp": ".", "file": 1, "line": 1, "column": 1, "message": 1 }],
					"background": {
						"beginsPattern": { "regexp": "building..." },
						"endsPattern": { "regexp": "^.*INF starting http server" }
					}
				}
			]
		},
		{
			"hide": true,
			"label": "Launch frontend",
			"command": "mage",
			"args": ["launch_frontend"],
			"icon": {
				"color": "terminal.ansiCyan",
				"id": "broadcast"
			}
		},
		{
			"hide": true,
			"label": "Compile Mage debug file",
			"command": "mage",
			"args": ["-compile", "./magefile-debug"],
			"icon": {
				"color": "terminal.ansiBlack",
				"id": "debug-console"
			},
			"presentation": {
				"panel": "shared"
			}
		},
		{
			"hide": true,
			"label": "Delete Mage debug file",
			"command": "rm magefiles/magefile-debug",
			"icon": {
				"color": "terminal.ansiBlack",
				"id": "trash"
			},
			"presentation": {
				"panel": "shared"
			}
		}
	],
	"inputs": [
		{
			"id": "testMode",
			"type": "pickString",
			"default": "true",
			"options": ["true", "false"],
			"description": "Select whether to start the database in-memory via test mode. Test mode starts with a preset collection of test games (modifiable in test/testgames.go), but changes will not persist when reloading the page."
		},
		{
			"id": "packages",
			"type": "promptString",
			"default": "${relativeFileDirname}",
			"description": "Enter a space-separated list of names or paths to packages to run \"go test\" on (relative to workspace root). Having no valid paths will default to running everything (./...)."
		},
		{
			"id": "goTestName",
			"type": "promptString",
			"default": ".*",
			"description": "Enter a regular expression matching test functions to run. Subtests are separated by slashes (/) and spaces are replaced by underscores (_)."
		},
		{
			"id": "benchTime",
			"type": "promptString",
			"default": "3",
			"description": "Enter amount of time (in seconds) to run each benchmark for."
		}
	]
}
