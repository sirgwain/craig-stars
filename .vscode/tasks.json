{
	"version": "2.0.0",
	"presentation": {
		"panel": "dedicated",
		"showReuseMessage": false,
		"clear": true
	},
	"tasks": [
		{
			"label": "Run all tests",
			"type": "shell",
			"command": "mage",
			"args": ["test"],
			"group": "test",
			"icon": {
				"color": "terminal.ansiGreen",
				"id": "beaker"
			},
			"detail": "Run all backend/frontend tests and linting checks."
		},
		{
			"label": "Go: run tests",
			"type": "shell",
			"command": "mage",
			"args": ["test_golang", "--run=\"^${input:goTestName}\""],
			"group": "test",
			"icon": {
				"color": "terminal.ansiGreen",
				"id": "run-below"
			},
			"detail": "Run backend tests using gotestsum."
		},
		{
			"label": "Go: run benchmarks",
			"type": "go",
			"problemMatcher": "$go",
			"command": "test",
			"args": [
				"--run=$^",
				"--bench=\"^${input:goTestName}\"",
				"--benchmem",
				"--benchtime=${input:benchTime}s",
				"--benchcount=5",
				"--json tmp/test-results/go-benchresults.json"
			],
			"group": "test",
			"icon": {
				"color": "terminal.ansiYellow",
				"id": "clock"
			},
			"detail": "Run Go benchmarks and save the results to JSON."
		},
		{
			"label": "Go: generate files",
			"type": "shell",
			"problemMatcher": "$go",
			"group": "build",
			"icon": {
				"color": "terminal.ansiMagenta",
				"id": "table"
			},
			"command": "mage generate",
			"detail": "Generate various backend and frontend files."
		},
		// Build commands for debugging the server
		{
			"label": "Build & launch server",
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"dependsOn": ["build server", "launch backend", "launch frontend", "open browser"],
			"dependsOrder": "sequence",
			"icon": {
				"color": "terminal.ansiCyan",
				"id": "browser"
			},
			"detail": "Start up the server for local development and launch it for debugging."
		},
		{
			"hide": true,
			"label": "build server",
			"type": "shell",
			"command": "mage",
			"args": ["build"],
			"icon": {
				"color": "terminal.ansiCyan",
				"id": "symbol-constructor"
			},
			"detail": "Build server without launching it."
		},
		{
			"hide": true,
			"label": "launch backend",
			"type": "shell",
			"command": "mage",
			"args": ["launch_backend"],
			"icon": {
				"color": "terminal.ansiBlue",
				"id": "radio-tower"
			},
			"presentation": {
				"panel": "dedicated",
				"showReuseMessage": false,
				"clear": true
			},
			// problem matcher needed to signify task end
			"problemMatcher": [
				{
					"pattern": [{ "regexp": ".", "file": 1, "line": 1, "column": 1, "message": 1 }],
					"background": {
						"activeOnStart": true,
						"beginsPattern": { "regexp": "." },
						"endsPattern": { "regexp": "starting http server" }
					}
				}
			]
		},
		{
			"hide": true,
			"label": "launch frontend",
			"type": "shell",
			"isBackground": true,
			"command": "mage",
			"args": ["launch_frontend"],
			"icon": {
				"color": "terminal.ansiBlue",
				"id": "broadcast"
			},
			// problem matcher needed to tell debug server when to start debugging
			"problemMatcher": [
				{
					"pattern": [{ "regexp": ".", "file": 1, "line": 1, "column": 1, "message": 1 }],
					"background": {
						"activeOnStart": true,
						"beginsPattern": { "regexp": "." },
						"endsPattern": { "regexp": "VITE .* ready in" }
					}
				}
			],
			"presentation": {
				"panel": "dedicated",
				"showReuseMessage": false,
				"clear": true
			}
		},
		{
			"hide": true,
			"label": "open browser",
			"command": "${command:extension.js-debug.debugLink}",
			"args": ["http://localhost:5173"],
			"icon": {
				"color": "terminal.ansiBlue",
				"id": "broadcast"
			}
		},
		{
			"hide": true,
			"label": "Compile Mage debug file",
			"type": "shell",
			"command": "mage",
			"args": ["-compile", "./magefile-debug"],
			"presentation": {
				"panel": "shared"
			},
			"icon": {
				"color": "terminal.ansiBlack",
				"id": "debug-console"
			}
		},
		{
			"hide": true,
			"label": "Delete Mage debug file",
			"type": "shell",
			"icon": {
				"color": "terminal.ansiBlack",
				"id": "trash"
			},
			"command": "rm magefiles/magefile-debug",
			"presentation": {
				"panel": "shared"
			}
		}
	],
	"inputs": [
		{
			"id": "goTestName",
			"type": "promptString",
			"default": ".*",
			"description": "Enter regex of test file names to run. Subtests are separated by slashes (/) and spaces are replaced by underscores (_)."
		},
		{
			"id": "benchTime",
			"type": "promptString",
			"default": "3",
			"description": "Enter amount of time (in seconds) to run each benchmark for."
		}
	]
}
