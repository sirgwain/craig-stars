{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Go: run tests",
            "type": "go",
            "problemMatcher": "$go",
            "command": "test",
            "args": [
                "${inputs:goTestFiles}",
                "-json tmp/go-testresults.json"
            ],
            "group": {
                "kind": "test",
                "isDefault": "true"
            },
            "icon": {
                "color": "terminal.ansiBlue",
                "id": "beaker"
            },
            "detail": "Run Go tests and save the results to JSON."
        },
        {
            "label": "Go: run benchmarks",
            "type": "go",
            "problemMatcher": "$go",
            "command": "test",
            "args": [
                "run=$^",
                "-bench=${inputs:goBenchFiles}",
                "-benchmem",
                "-benchtime=${inputs:benchTime}s",
                "-benchcount=5",
                "-json tmp/go-benchresults.json"
            ],
            "group": "test",
            "icon": {
                "color": "terminal.ansiYellow",
                "id": "clock"
            },
            "detail": "Run Go benchmarks and save the results to JSON."
        },
        {
            "label": "Go: Generate files & techs.JSON",
            "type": "shell",
            "problemMatcher": "$go",
            "group": "build",
            "icon": {
                "color": "terminal.ansiMagenta",
                "id": "table"
            },
            "command": "mage generate",
            "detail": "mage generate"
        },
        {
            "label": "Build & launch server",
            "type": "shell",
            "command": "mage run",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "icon": {
                "color": "terminal.ansiCyan",
                "id": "run-all"
            },
            "detail": "Start up the server for local development using mage."
        },
        {
            "hide": true,
            "label": "Compile Mage debug file",
            "type": "shell",
            "icon": {
                "id": "debug-console",
                "color": "terminal.ansiGreen"
            },
            "command": "mage -compile ./magefile-debug"
        },
        {
            "hide": true,
            "label": "Delete Mage debug file",
            "type": "shell",
            "icon": {
                "id": "trash",
                "color": "terminal.ansiRed"
            },
            "command": "rm magefiles/magefile-debug"
        }
    ],
    "inputs": [
        {
            "id": "goBenchFiles",
            "type": "promptString",
            "default": ".",
            "description": "Enter regex of test function names to benchmark."
        },
        {
            "id": "goTestFiles",
            "type": "promptString",
            "default": ".",
            "description": "Enter regex of files to run command against."
        },
        {
            "id": "benchTime",
            "type": "promptString",
            "default": "3",
            "description": "Enter amount of time to run each benchmark for."
        }
    ]
}
