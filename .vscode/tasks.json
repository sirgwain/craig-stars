{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "go",
      "label": "Go: test current file",
      "command": "test",
      "args": ["${fileDirname}"],
      "problemMatcher": "$go",
      "group": {
        "kind": "test",
        "isDefault": "true"
      },
      "detail": "cd ${workspaceFolder}; go test ${fileDirname}"
    },
    {
      "label": "Go: generate wasm serializers/techs.json",
      "type": "shell",
      "problemMatcher": "$go",
      "group": "build",
      "command": "make generate",
      "detail": "make generate"
    },
    {
      "label": "Make: Build & Launch server",
      "type": "shell",
      "command": "make run",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "make clean build dev"
    },
    {
      "label": "Make: Run benchmarks",
      "type": "shell",
      "command": "make bench",
      "group": {
        "kind": "test"
      },
      "detail": "go test run=^$ -bench=. -benchmem -benchtime=2s -benchcount=5 -outfile=tmp/go-benchresults.json"
    }
  ]
}
