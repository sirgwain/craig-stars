{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "serve",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/main.go",
            "args": ["serve"]
        },
        {
            "name": "serve --generate-test-game",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/main.go",
            "args": ["serve", "--generate-test-game"]
        },
        {
            "name": "generate wasm serializers",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/wasm/generator/main.go",
            "cwd": "${workspaceFolder}",
            "args": ["./cs", "wasm/wasm/generated.go"]
        },
        {
            "name": "migrate",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/main.go",
            "args": ["migrate"]
        },
        {
            "name": "generate",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/main.go",
            "args": ["generate", "game", "--name", "A Barefoot Jaywalk", "--user-id", "1"]
        },
        {
            "name": "test",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${relativeFileDirname}",
        },
        {
            "name": "test -test.run <case>",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${workspaceFolder}/server/gamerunner_test.go",
            "args": ["-test.run", "Test_gameRunner_GenerateTurns"]
        },
        {
            "name": "Debug Magefile Target",
            "type": "go",
            "request": "launch",
            "mode": "exec",
            "cwd": "${workspaceFolder}",
            "program": "magefiles/magefile-debug",
            "args": ["${input:mageTarget}"],
            "preLaunchTask": "Compile Mage debug file",
            "postDebugTask": "Delete Mage debug file"
        },
    ],
    "inputs": [
        {
            "id": "mageTarget",
            "type": "pickString",
            "description": "Select Magefile target to debug.",
            "options": [
                "run",
                "test",
                "images",
                "build",
                "build_frontend",
                "copy_wasm",
                "build_server",
                "generate",
                "launch",
                "launch_backend",
                "launch_frontend",
                "clean",
                "tidy"
            ],
            "default": "run"
        },
    ]
}
